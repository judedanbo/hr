# Non-secret configuration for production. Rendered into a ConfigMap by
# kustomize's configMapGenerator, which appends a content hash to the name so a
# change here rolls the pods automatically.
#
# Secrets live in the `hrmis-production-app-secret` Secret — see k8s/README.md.

APP_NAME=GAS - HRMIS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hr.audit.gov.gh
ASSET_URL=https://hr.audit.gov.gh

# stderr so that `kubectl logs` shows application errors. The previous setup
# wrote to files inside the container, where nobody ever saw them.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=hrmis-production-database
DB_PORT=3306

# Both environments share the `hr` namespace, so a bare `redis` hostname (as the
# old ConfigMap had) would be ambiguous even once a Redis existed.
REDIS_HOST=hrmis-production-redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# QUEUE_CONNECTION, not the old QUEUE_DRIVER — that key is Laravel 5 naming and
# Laravel 11 ignores it. Every app/Exports/* class implements ShouldQueue, so
# this only works because a queue worker Deployment ships alongside it.
QUEUE_CONNECTION=redis

# The old ConfigMap claimed `pusher`, but the key was never wired into the pod,
# so the live application has always run with `log`. Confirmed by the service
# owner as the intended setting — this is not an oversight to be "fixed" later.
# Switching it to pusher would be a behaviour change requiring real credentials.
BROADCAST_DRIVER=log

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=hrmis@audit.gov.gh
MAIL_FROM_ADDRESS=hrmis@audit.gov.gh
# Set literally: Kubernetes expands $(VAR), not ${VAR}, and Laravel only expands
# inside .env files — so the old `${APP_NAME}` reached the app unexpanded.
MAIL_FROM_NAME=GAS - HRMIS

# Both packages sit in composer.json `require`, not `require-dev`, and are
# registered unconditionally, so --no-dev still installs them. config/telescope.php
# defaults `enabled` to true; only an explicit false keeps Telescope off.
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
