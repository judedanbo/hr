# Non-secret configuration for staging.
#
# Secrets — including APP_KEY, which currently sits in plaintext in the live
# `hrmis-config-map` — live in the `hrmis-test-app-secret` Secret. See k8s/README.md.

APP_NAME=HRMIS (Staging)
APP_ENV=production
# Off deliberately: this host is public, and Debugbar/Telescope routes are
# reachable when debug is on. The live staging pod runs with APP_DEBUG=true.
APP_DEBUG=false
APP_URL=https://test-hr.audit.gov.gh
ASSET_URL=https://test-hr.audit.gov.gh

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=hrmis-test-database
DB_PORT=3306

REDIS_HOST=hrmis-test-redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=log

FILESYSTEM_DISK=local

# Staging sends no real mail: log the message rather than relaying it through
# Office 365 and risking a test notification reaching a real member of staff.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hrmis@audit.gov.gh
MAIL_FROM_NAME=HRMIS (Staging)

TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
